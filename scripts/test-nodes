#!/usr/bin/env bash
#
# Two-chain regtest rig for the blake-swap test suites.
#
# The suites need two independent Bitcoin-protocol regtest chains:
#
#   btc    the BTC side      -> Bitcoin Core   (stock v30.3)
#   blake  the BLAKE side    -> Bitcoin Knots  (v29.3.0.knots20260508)
#
# Both participants in the test suites (alice and bob) talk to the same
# node per chain and use separate wallets on it, so the rig is exactly
# two nodes. Because Core and Knots share the default regtest ports, the
# BLAKE node is moved to the 194xx range.
#
# This validates the swap machinery across two independent node
# implementations. It does not exercise the blake2b consensus of the
# original BLAKE chain, whose node software is not available locally;
# point BLAKE_SWAP_TEST_BLAKE_CLI at that binary when it is.
#
# Usage:
#   scripts/test-nodes start     start both nodes and print the env exports
#   scripts/test-nodes stop      stop both nodes
#   scripts/test-nodes restart   stop then start
#   scripts/test-nodes status    show both nodes
#   scripts/test-nodes reset     stop, then delete both datadirs
#   scripts/test-nodes env       print the exports for the current shell
#   scripts/test-nodes mine N    mine N blocks on both chains
#   scripts/test-nodes help
#
# On start/stop the rig publishes $BLAKE_SWAP_TEST_ROOT/rig-env.json.
# tests/node_config.py reads it, so a running rig is used automatically
# and a stopped rig makes the node-dependent suites SKIP instead of
# failing to connect.
#
# Defaults (override with the same env vars):
#   BLAKE_SWAP_TEST_ROOT       $HOME/.blake-swap-test
#   BLAKE_SWAP_TEST_BTC_CLI    $HOME/s/bitcoin-core/bin/bitcoin-cli
#   BLAKE_SWAP_TEST_BLAKE_CLI  $HOME/s/bitcoin-knots/bin/bitcoin-cli

set -uo pipefail

# --- configuration -------------------------------------------------

TEST_ROOT="${BLAKE_SWAP_TEST_ROOT:-$HOME/.blake-swap-test}"

BTC_CLI="${BLAKE_SWAP_TEST_BTC_CLI:-$HOME/s/bitcoin-core/bin/bitcoin-cli}"
BLAKE_CLI="${BLAKE_SWAP_TEST_BLAKE_CLI:-$HOME/s/bitcoin-knots/bin/bitcoin-cli}"

BTC_DATADIR="$TEST_ROOT/btc"
BLAKE_DATADIR="$TEST_ROOT/blake"

BTC_RPCPORT="${BLAKE_SWAP_TEST_BTC_RPCPORT:-18443}"
BTC_PORT="${BLAKE_SWAP_TEST_BTC_PORT:-18444}"
BLAKE_RPCPORT="${BLAKE_SWAP_TEST_BLAKE_RPCPORT:-19443}"
BLAKE_PORT="${BLAKE_SWAP_TEST_BLAKE_PORT:-19444}"

# Coinbase maturity plus a margin, so both chains have spendable funds.
INITIAL_BLOCKS="${BLAKE_SWAP_TEST_INITIAL_BLOCKS:-101}"

RPC_WAIT_SECONDS="${BLAKE_SWAP_TEST_RPC_WAIT:-60}"

BTCD="${BTC_CLI%/bitcoin-cli}/bitcoind"
BLAKED="${BLAKE_CLI%/bitcoin-cli}/bitcoind"

# --- helpers -------------------------------------------------------

die() {
    echo "ERROR: $*" >&2
    exit 2
}

need_binaries() {
    [[ -x "$BTC_CLI" ]] || die "Bitcoin Core CLI not found: $BTC_CLI
Set BLAKE_SWAP_TEST_BTC_CLI, or see ~/s/bitcoin-core/README.md"

    [[ -x "$BLAKE_CLI" ]] || die "Bitcoin Knots CLI not found: $BLAKE_CLI
Set BLAKE_SWAP_TEST_BLAKE_CLI, or see ~/s/bitcoin-knots/README.md"

    [[ -x "$BTCD" ]] || die "Bitcoin Core daemon not found: $BTCD"
    [[ -x "$BLAKED" ]] || die "Bitcoin Knots daemon not found: $BLAKED"
}

write_conf() {
    local datadir="$1" rpcport="$2" port="$3" label="$4"

    mkdir -p "$datadir"

    cat > "$datadir/bitcoin.conf" <<EOF
# Generated by scripts/test-nodes for the blake-swap test rig.
# chain: $label
regtest=1
server=1
listen=1
daemon=0

# Regtest has no fee estimation; without this sendtoaddress fails.
fallbackfee=0.0001

# Keep txindex OFF: the settlement code passes a block hash to
# getrawtransaction, and one recovery suite deliberately covers the
# no-txindex case.
txindex=0

[regtest]
rpcbind=127.0.0.1
rpcallowip=127.0.0.1
rpcport=$rpcport
bind=127.0.0.1
port=$port
EOF
}

write_rig_env() {
    local running="$1"

    mkdir -p "$TEST_ROOT"

    cat > "$TEST_ROOT/rig-env.json" <<EOF
{
  "running": $running,
  "root": "$TEST_ROOT",
  "btc_cli": "$BTC_CLI",
  "blake_cli": "$BLAKE_CLI",
  "btc_datadir": "$BTC_DATADIR",
  "blake_datadir": "$BLAKE_DATADIR",
  "btc_rpcport": $BTC_RPCPORT,
  "btc_port": $BTC_PORT,
  "blake_rpcport": $BLAKE_RPCPORT,
  "blake_port": $BLAKE_PORT
}
EOF
}

rpc_ready() {
    local cli="$1" datadir="$2"
    "$cli" -datadir="$datadir" getblockchaininfo >/dev/null 2>&1
}

wait_for_rpc() {
    local cli="$1" datadir="$2" label="$3"
    local waited=0

    while [[ "$waited" -lt "$RPC_WAIT_SECONDS" ]]; do
        if rpc_ready "$cli" "$datadir"; then
            return 0
        fi
        sleep 0.5
        waited=$((waited + 1))
    done

    return 1
}

node_running() {
    local cli="$1" datadir="$2"
    rpc_ready "$cli" "$datadir"
}

stop_node() {
    local label="$1" cli="$2" datadir="$3"

    if ! node_running "$cli" "$datadir"; then
        echo "  $label: not running"
        return 0
    fi

    "$cli" -datadir="$datadir" stop >/dev/null 2>&1 || true

    local waited=0
    while [[ "$waited" -lt 40 ]]; do
        node_running "$cli" "$datadir" || break
        sleep 0.5
        waited=$((waited + 1))
    done

    if node_running "$cli" "$datadir"; then
        echo "  $label: WARNING did not stop cleanly"
        return 1
    fi

    echo "  $label: stopped"
    return 0
}

ensure_wallet() {
    local cli="$1" datadir="$2" wallet="$3"

    local loaded
    loaded="$("$cli" -datadir="$datadir" listwallets 2>/dev/null || echo '[]')"

    if grep -q "\"$wallet\"" <<<"$loaded"; then
        return 0
    fi

    "$cli" -datadir="$datadir" createwallet "$wallet" >/dev/null 2>&1 || \
        "$cli" -datadir="$datadir" loadwallet "$wallet" >/dev/null 2>&1 || true
}

mine() {
    local cli="$1" datadir="$2" wallet="$3" blocks="$4"

    local addr
    addr="$("$cli" -datadir="$datadir" -rpcwallet="$wallet" getnewaddress "" bech32 2>/dev/null)"

    if [[ -z "$addr" ]]; then
        echo "  could not get a mining address" >&2
        return 1
    fi

    "$cli" -datadir="$datadir" generatetoaddress "$blocks" "$addr" >/dev/null 2>&1
}

print_env() {
    cat <<EOF
# blake-swap test rig environment
#
# These are only needed to override the rig, or to export it into a
# shell that will not run the suites through scripts/test.sh. A running
# rig is discovered automatically via $TEST_ROOT/rig-env.json.
export BLAKE_SWAP_BTC_CLI="$BTC_CLI"
export BLAKE_SWAP_BTC_DATADIR="$BTC_DATADIR"
export BLAKE_SWAP_BLAKE_CLI="$BLAKE_CLI"
export BLAKE_SWAP_BLAKE_DATADIR="$BLAKE_DATADIR"
EOF
}

# --- commands ------------------------------------------------------

cmd_start() {
    need_binaries

    echo "BLAKE SWAP TEST NODES"
    echo "====================="
    echo "root: $TEST_ROOT"
    echo

    write_conf "$BTC_DATADIR" "$BTC_RPCPORT" "$BTC_PORT" "btc (Bitcoin Core)"
    write_conf "$BLAKE_DATADIR" "$BLAKE_RPCPORT" "$BLAKE_PORT" "blake (Bitcoin Knots)"

    echo "starting nodes..."

    "$BTCD" -datadir="$BTC_DATADIR" -daemon >/dev/null 2>&1
    "$BLAKED" -datadir="$BLAKE_DATADIR" -daemon >/dev/null 2>&1

    if ! wait_for_rpc "$BTC_CLI" "$BTC_DATADIR" "btc"; then
        die "Bitcoin Core RPC did not come up. Check $BTC_DATADIR/regtest/debug.log"
    fi
    if ! wait_for_rpc "$BLAKE_CLI" "$BLAKE_DATADIR" "blake"; then
        die "Bitcoin Knots RPC did not come up. Check $BLAKE_DATADIR/regtest/debug.log"
    fi

    echo "  btc:   RPC ready (rpcport $BTC_RPCPORT)"
    echo "  blake: RPC ready (rpcport $BLAKE_RPCPORT)"

    ensure_wallet "$BTC_CLI" "$BTC_DATADIR" rig
    ensure_wallet "$BLAKE_CLI" "$BLAKE_DATADIR" rig

    local btc_blocks blake_blocks
    btc_blocks="$("$BTC_CLI" -datadir="$BTC_DATADIR" getblockcount 2>/dev/null || echo 0)"
    blake_blocks="$("$BLAKE_CLI" -datadir="$BLAKE_DATADIR" getblockcount 2>/dev/null || echo 0)"

    if [[ "$btc_blocks" -lt 101 ]]; then
        mine "$BTC_CLI" "$BTC_DATADIR" rig "$INITIAL_BLOCKS" >/dev/null 2>&1 || true
        echo "  btc:   mined $INITIAL_BLOCKS blocks"
    fi

    if [[ "$blake_blocks" -lt 101 ]]; then
        mine "$BLAKE_CLI" "$BLAKE_DATADIR" rig "$INITIAL_BLOCKS" >/dev/null 2>&1 || true
        echo "  blake: mined $INITIAL_BLOCKS blocks"
    fi

    write_rig_env true

    echo
    echo "READY. The suites discover this rig automatically; run:"
    echo
    echo "  ./scripts/test.sh              # all suites with nodes"
    echo "  ./scripts/coverage.sh          # same, with coverage"
    echo
    echo "To point a separate shell at it instead:"
    echo
    print_env
}

cmd_stop() {
    echo "stopping nodes..."
    stop_node "btc" "$BTC_CLI" "$BTC_DATADIR" || true
    stop_node "blake" "$BLAKE_CLI" "$BLAKE_DATADIR" || true
    write_rig_env false
    echo "done."
}

cmd_status() {
    echo "BLAKE SWAP TEST NODES"
    echo "====================="

    local label cli datadir
    for pair in "btc:$BTC_CLI:$BTC_DATADIR" "blake:$BLAKE_CLI:$BLAKE_DATADIR"; do
        IFS=: read -r label cli datadir <<<"$pair"

        printf '%-6s cli=%s\n' "$label" "$cli"

        if [[ ! -x "$cli" ]]; then
            printf '%-6s MISSING CLI\n' ""
            continue
        fi

        if node_running "$cli" "$datadir"; then
            local info chain blocks
            info="$("$cli" -datadir="$datadir" getblockchaininfo 2>/dev/null)"
            chain="$(grep -m1 '"chain"' <<<"$info" | tr -d ' ,"' | cut -d: -f2)"
            blocks="$(grep -m1 '"blocks"' <<<"$info" | tr -d ' ,"' | cut -d: -f2)"
            printf '%-6s RUNNING chain=%s blocks=%s datadir=%s\n' "" "$chain" "$blocks" "$datadir"
        else
            printf '%-6s stopped datadir=%s\n' "" "$datadir"
        fi
    done
}

cmd_reset() {
    cmd_stop
    echo "deleting $TEST_ROOT ..."
    rm -rf "$TEST_ROOT"
    echo "done."
}

cmd_mine() {
    local blocks="${1:-1}"

    echo "mining $blocks block(s) on both chains..."
    mine "$BTC_CLI" "$BTC_DATADIR" rig "$blocks" && echo "  btc:   ok" || echo "  btc:   FAILED"
    mine "$BLAKE_CLI" "$BLAKE_DATADIR" rig "$blocks" && echo "  blake: ok" || echo "  blake: FAILED"
}

cmd_help() {
    sed -n '2,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

case "${1:-help}" in
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_stop; echo; cmd_start ;;
    status) cmd_status ;;
    reset) cmd_reset ;;
    env) print_env ;;
    mine) shift; cmd_mine "${1:-1}" ;;
    help|-h|--help) cmd_help ;;
    *)
        echo "ERROR: unknown command: $1" >&2
        echo >&2
        cmd_help >&2
        exit 2
        ;;
esac
