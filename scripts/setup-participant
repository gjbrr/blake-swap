#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -x "$HOME/blake-swap-venv/bin/python3" ]]; then
    PY="$HOME/blake-swap-venv/bin/python3"
else
    PY="${PYTHON:-python3}"
fi

ROLE="${1:-alice}"

case "$ROLE" in
    alice|bob)
        ;;
    *)
        echo "ERROR: development protocol role must be alice or bob" >&2
        echo "Usage: scripts/setup-participant [alice|bob]" >&2
        exit 2
        ;;
esac

#
# Do not bootstrap a new participant while another participant
# profile is loaded. That could silently reuse its state/wallet.
#
if [[ -n "${BLAKE_SWAP_STATE_DIR:-}" || -n "${BLAKE_SWAP_CHAIN_WALLET:-}" ]]; then
    echo "ERROR: an existing BLAKE Swap participant profile is loaded." >&2
    echo "Run setup-participant from a clean shell so participant state cannot leak." >&2
    exit 2
fi

BTC_CLI="${BLAKE_SWAP_BTC_CLI:-$HOME/bitcoin-core/build/bin/bitcoin-cli}"
BTC_DATADIR="${BLAKE_SWAP_BTC_DATADIR:-$HOME/bitcoin-swap-regtest}"

BLAKE_CLI="${BLAKE_SWAP_BLAKE_CLI:-$HOME/bitcoin-blake-rc2/build-rc2/bin/bitcoin-cli}"
BLAKE_DATADIR="${BLAKE_SWAP_BLAKE_DATADIR:-$HOME/blake-swap-regtest}"

WALLET="${BLAKE_SWAP_SETUP_WALLET:-blakeswap}"

STATE_DIR="${BLAKE_SWAP_SETUP_STATE_DIR:-$HOME/.blake-swap}"
NOSTR_KEY_DIR="${BLAKE_SWAP_NOSTR_KEY_DIR:-$STATE_DIR/nostr-keys}"

RELAYS="${BLAKE_SWAP_NOSTR_RELAYS:-wss://TheForest.nostr1.com,wss://nos.lol}"

PROFILE="${BLAKE_SWAP_SETUP_PROFILE:-$ROOT/scripts/participant-env}"

pass() { printf 'PASS  %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*" >&2; exit 1; }

echo
echo "BLAKE SWAP PARTICIPANT SETUP"
echo "============================"
echo "development role: $ROLE"

check_cli() {
    local label="$1"
    local cli="$2"

    if [[ -x "$cli" ]]; then
        pass "$label CLI found: $cli"
    else
        fail "$label CLI not found or not executable: $cli"
    fi
}

check_rpc() {
    local label="$1"
    local cli="$2"
    local datadir="$3"

    if "$cli" -regtest -datadir="$datadir" getblockchaininfo >/dev/null 2>&1; then
        pass "$label RPC reachable"
    else
        fail "$label RPC unavailable using datadir: $datadir"
    fi
}

wallet_exists() {
    local cli="$1"
    local datadir="$2"
    local wallet="$3"

    "$cli" -regtest -datadir="$datadir" listwalletdir |
     "$PY" -c '
import json, sys
wanted = sys.argv[1]
obj = json.load(sys.stdin)
names = [x.get("name") for x in obj.get("wallets", [])]
raise SystemExit(0 if wanted in names else 1)
' "$wallet"
}

wallet_loaded() {
    local cli="$1"
    local datadir="$2"
    local wallet="$3"

    "$cli" -regtest -datadir="$datadir" listwallets |
     "$PY" -c '
import json, sys
wanted = sys.argv[1]
loaded = json.load(sys.stdin)
raise SystemExit(0 if wanted in loaded else 1)
' "$wallet"
}

ensure_wallet() {
    local label="$1"
    local cli="$2"
    local datadir="$3"
    local wallet="$4"

    if wallet_exists "$cli" "$datadir" "$wallet"; then
        pass "$label wallet \"$wallet\" already exists"
    else
        echo "CREATE $label wallet \"$wallet\""
        "$cli" \
          -regtest \
          -datadir="$datadir" \
          createwallet "$wallet" >/dev/null
        pass "$label wallet \"$wallet\" created"
    fi

    if wallet_loaded "$cli" "$datadir" "$wallet"; then
        pass "$label wallet \"$wallet\" is loaded"
    else
        "$cli" \
          -regtest \
          -datadir="$datadir" \
          loadwallet "$wallet" >/dev/null
        pass "$label wallet \"$wallet\" loaded"
    fi

    if "$cli" \
        -regtest \
        -datadir="$datadir" \
        -rpcwallet="$wallet" \
        getwalletinfo >/dev/null 2>&1; then
        pass "$label wallet RPC usable"
    else
        fail "$label wallet RPC unavailable"
    fi
}

check_cli "Bitcoin" "$BTC_CLI"
check_cli "BLAKE" "$BLAKE_CLI"

echo
echo "CHAIN RPC"
echo "---------"

check_rpc "Bitcoin" "$BTC_CLI" "$BTC_DATADIR"
check_rpc "BLAKE" "$BLAKE_CLI" "$BLAKE_DATADIR"

echo
echo "WALLETS"
echo "-------"

ensure_wallet "Bitcoin" "$BTC_CLI" "$BTC_DATADIR" "$WALLET"
ensure_wallet "BLAKE" "$BLAKE_CLI" "$BLAKE_DATADIR" "$WALLET"

echo
echo "LOCAL STATE"
echo "-----------"

mkdir -p "$STATE_DIR"
mkdir -p "$NOSTR_KEY_DIR"

chmod 700 "$STATE_DIR"
chmod 700 "$NOSTR_KEY_DIR"

pass "state directory ready: $STATE_DIR"
pass "Nostr key directory ready: $NOSTR_KEY_DIR"

PARTICIPANT_KEY_FILE="$STATE_DIR/participant.key"

if [[ ! -f "$PARTICIPANT_KEY_FILE" ]]; then
    umask 077

    "$PY" - <<'PY_KEY' > "$PARTICIPANT_KEY_FILE"
from coincurve import PrivateKey
print(PrivateKey().secret.hex())
PY_KEY

    chmod 600 "$PARTICIPANT_KEY_FILE"
    pass "Nostr participant identity created"
else
    pass "Nostr participant identity already exists"
fi

cat > "$PROFILE" <<EOF_PROFILE
# Generated by scripts/setup-participant
# BLAKE_SWAP_ROLE is currently a development protocol-role setting.
# It is not the participant's permanent identity.

# Prevent settings from another participant profile leaking into this one.
unset BLAKE_SWAP_RUNNER_UNIT

export BLAKE_SWAP_ROLE="$ROLE"
export BLAKE_SWAP_CHAIN_WALLET="$WALLET"

export BLAKE_SWAP_TRANSPORT=nostr
export BLAKE_SWAP_STATE_DIR="$STATE_DIR"
export BLAKE_SWAP_NOSTR_KEY_DIR="$NOSTR_KEY_DIR"
export BLAKE_SWAP_PARTICIPANT_KEY_FILE="$PARTICIPANT_KEY_FILE"
export BLAKE_SWAP_NOSTR_RELAYS="$RELAYS"

export BLAKE_SWAP_BTC_CLI="$BTC_CLI"
export BLAKE_SWAP_BTC_DATADIR="$BTC_DATADIR"

export BLAKE_SWAP_BLAKE_CLI="$BLAKE_CLI"
export BLAKE_SWAP_BLAKE_DATADIR="$BLAKE_DATADIR"

echo "Loaded BLAKE Swap participant environment"
EOF_PROFILE

chmod 600 "$PROFILE"

pass "participant profile written: $PROFILE"

echo
echo "HEALTH CHECK"
echo "------------"

"$ROOT/scripts/blake-health" "$PROFILE"

echo
echo "SETUP COMPLETE"
echo "=============="
echo "No funds were moved."
echo "No Nostr event was published."
echo
echo "Load the profile with:"
echo
echo "  source $PROFILE"
