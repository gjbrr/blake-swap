#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENGINE="$ROOT/src/swap_v2.py"

if [[ -x "$HOME/blake-swap-venv/bin/python3" ]]; then
  PY="$HOME/blake-swap-venv/bin/python3"
else
  PY="${PYTHON:-python3}"
fi

export PYTHONPATH="$ROOT/src:$ROOT/vendor${PYTHONPATH:+:$PYTHONPATH}"

need_profile() {
  if [[ -z "${BLAKE_SWAP_ROLE:-}"      || -z "${BLAKE_SWAP_STATE_DIR:-}" ]]; then
    cat >&2 <<'EOF'
ERROR: no participant profile is loaded.

On the laptop:
  source scripts/alice-env

On Start9:
  source scripts/bob-env
EOF
    exit 2
  fi

  if [[ -n "${BLAKE_SWAP_PARTICIPANT_KEY_FILE:-}" ]]; then
    if [[ ! -f "$BLAKE_SWAP_PARTICIPANT_KEY_FILE" ]]; then
      echo "ERROR: participant key file does not exist:" >&2
      echo "  $BLAKE_SWAP_PARTICIPANT_KEY_FILE" >&2
      exit 2
    fi
    return
  fi

  if [[ -n "${BLAKE_SWAP_NOSTR_KEY_DIR:-}" ]]; then
    if [[ ! -d "$BLAKE_SWAP_NOSTR_KEY_DIR" ]]; then
      echo "ERROR: Nostr key directory does not exist:" >&2
      echo "  $BLAKE_SWAP_NOSTR_KEY_DIR" >&2
      exit 2
    fi
    return
  fi

  echo "ERROR: participant profile has no usable Nostr key location." >&2
  echo "Expected BLAKE_SWAP_PARTICIPANT_KEY_FILE or BLAKE_SWAP_NOSTR_KEY_DIR." >&2
  exit 2
}

engine() {
  "$PY" "$ENGINE" "$@"
}

usage() {
  cat <<'EOF'
BLAKE SWAP

Typical workflow
================

Maker:
  blake offer blake-for-btc \
      --blake 1 \
      --sats 370000 \
      --minutes 30

  blake next

  blake run [seconds]
      Foreground supervisor: safe coordination + post-funding settlement
  blake fund
  blake resume [swap-prefix]

Taker:
  blake next
  blake resume [swap-prefix]

Market / work queue
===================

  blake market
  blake swaps
  blake next

Explicit coordination / cleanup
===============================

  blake take <offer-prefix>
  blake accept-take <offer-prefix>
  blake accept-match [match-prefix]
  blake ignore-match <match-prefix>
  blake dismiss <swap-prefix>

Advanced / diagnostic
=====================

  blake show <swap-id>
  blake reconcile <swap-id>
  blake status
  blake engine <raw swap_v2.py arguments...>

Safety model
============

  * `next` may perform only unambiguous non-economic coordination.
  * initial BLAKE funding is always an explicit `fund` commitment.
  * after funding, `resume` handles configured settlement/recovery actions.
  * ambiguous IDs or multiple live choices fail closed.
  * `dismiss` is local archival and refuses funded/unsafe state.
  * `ignore-match` is a local tombstone only; it does not alter Nostr.
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  help|-h|--help)
    usage
    ;;

  market)
    need_profile
    "$ROOT/scripts/blake-swap" market "$@"
    ;;

  offer)
    need_profile
    "$ROOT/scripts/blake-swap" offer "$@"
    ;;

  take)
    need_profile
    if [[ $# -ne 1 ]]; then
      echo "Usage: blake take <offer-prefix>" >&2
      exit 2
    fi
    "$ROOT/scripts/blake-swap" take "$1"
    ;;

  accept-take)
    need_profile
    if [[ $# -ne 1 ]]; then
      echo "Usage: blake accept-take <offer-prefix>" >&2
      exit 2
    fi
    engine accept-take "$1"
    ;;

  accept-match)
    need_profile
    if [[ $# -gt 1 ]]; then
      echo "Usage: blake accept-match [match-prefix]" >&2
      exit 2
    fi
    engine accept-match "$@"
    ;;

  next)
    need_profile
    if [[ $# -ne 0 ]]; then
      echo "Usage: blake next" >&2
      exit 2
    fi
    engine next
    ;;

  ignore-match)
    need_profile
    if [[ $# -ne 1 ]]; then
      echo "Usage: blake ignore-match <match-prefix>" >&2
      exit 2
    fi
    engine ignore-match "$1"
    ;;

  fund)
    need_profile
    if [[ $# -ne 0 ]]; then
      echo "Usage: blake fund" >&2
      exit 2
    fi
    engine fund
    ;;

  run)
    if [ "$#" -gt 1 ]; then
      echo "Usage: blake run [seconds]" >&2
      exit 2
    fi

    interval="${1:-15}"

    case "$interval" in
      ''|*[!0-9]*)
        echo "ERROR: run interval must be a positive integer number of seconds" >&2
        exit 2
        ;;
    esac

    if [ "$interval" -lt 2 ]; then
      echo "ERROR: run interval must be at least 2 seconds" >&2
      exit 2
    fi

    echo
    echo "BLAKE SWAP FOREGROUND RUNNER"
    echo "============================"
    echo "poll interval: ${interval}s"
    echo
    echo "POLICY:"
    echo "  * safe coordination may run automatically"
    echo "  * every independently safe funded swap may advance"
    echo "  * one broken/ambiguous swap does not block other swaps"
    echo "  * initial BLAKE funding is NEVER automatic"
    echo "  * Ctrl-C stops this foreground runner"
    echo

    while :; do
      if next_output="$(engine next 2>&1)"; then
        next_status=0
      else
        next_status=$?
      fi

      printf '%s\n' "$next_output"

      if [ "$next_status" -ne 0 ]; then
        echo
        echo "COORDINATION PAUSED"
        echo "==================="
        echo "next returned an error; settlement supervision will still run."
      fi

      if printf '%s\n' "$next_output" | grep -q '^READY TO FUND$'; then
        echo
        echo "ACTION REQUIRED"
        echo "==============="
        echo "Initial BLAKE funding requires an explicit:"
        echo "  scripts/blake fund"
      fi

      if settle_output="$(engine resume-all 2>&1)"; then
        settle_status=0
      else
        settle_status=$?
      fi

      printf '%s\n' "$settle_output"

      if [ "$settle_status" -ne 0 ]; then
        echo
        echo "SETTLEMENT PASS ERROR"
        echo "====================="
        echo "The runner will continue polling; inspect the output above."
      fi

      sleep "$interval"
    done
    ;;

  resume)
    need_profile
    if [[ $# -gt 1 ]]; then
      echo "Usage: blake resume [swap-prefix]" >&2
      exit 2
    fi
    engine resume "$@"
    ;;

  dismiss)
    need_profile
    if [[ $# -ne 1 ]]; then
      echo "Usage: blake dismiss <swap-prefix>" >&2
      exit 2
    fi
    engine dismiss "$1"
    ;;

  swaps|my-swaps)
    need_profile
    engine dashboard
    ;;

  show)
    need_profile
    engine show "$@"
    ;;

  reconcile)
    need_profile
    engine reconcile "$@"
    ;;

  status)
    need_profile
    engine status "$@"
    ;;

  engine)
    need_profile
    engine "$@"
    ;;

  *)
    echo "ERROR: unknown command: $cmd" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
