#!/usr/bin/env bash
set -euo pipefail

echo "BLAKE SWAP ENVIRONMENT"
echo "======================"
echo "role:        ${BLAKE_SWAP_ROLE:-<unset>}"
echo "wallet:      ${BLAKE_SWAP_CHAIN_WALLET:-<unset>}"
echo "state dir:   ${BLAKE_SWAP_STATE_DIR:-<unset>}"
echo "key dir:     ${BLAKE_SWAP_NOSTR_KEY_DIR:-<unset>}"
echo "key file:    ${BLAKE_SWAP_PARTICIPANT_KEY_FILE:-<unset>}"
echo "transport:   ${BLAKE_SWAP_TRANSPORT:-<unset>}"
echo "relays:      ${BLAKE_SWAP_NOSTR_RELAYS:-<unset>}"
echo "btc cli:     ${BLAKE_SWAP_BTC_CLI:-<default>}"
echo "btc datadir: ${BLAKE_SWAP_BTC_DATADIR:-<default>}"
echo "blake cli:   ${BLAKE_SWAP_BLAKE_CLI:-<default>}"
echo "blake data:  ${BLAKE_SWAP_BLAKE_DATADIR:-<default>}"
echo

if [[ -z "${BLAKE_SWAP_ROLE:-}" ]]; then
    echo "ERROR: BLAKE_SWAP_ROLE is unset"
    exit 1
fi

if [[ "${BLAKE_SWAP_ROLE}" != "alice" && "${BLAKE_SWAP_ROLE}" != "bob" ]]; then
    echo "ERROR: invalid role: ${BLAKE_SWAP_ROLE}"
    exit 1
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ -x "$ROOT/.venv/bin/python" ]]; then
    PY="$ROOT/.venv/bin/python"
elif [[ -x "$HOME/blake-swap-venv/bin/python3" ]]; then
    PY="$HOME/blake-swap-venv/bin/python3"
else
    PY="${PYTHON:-python3}"
fi

#
# The interpreter that showed the environment should be the same one
# that resolves it, so print it along with the engine's own view.
#
echo "interpreter: $PY"
echo

PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
"$PY" - <<'PY'
import swap_v2

print(
    "nostr pub:   ",
    swap_v2.current_nostr_pubkey(),
)
PY
